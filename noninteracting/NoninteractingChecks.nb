Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Solve", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"Fa", "==", 
      RowBox[{"A", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"Sin", "[", 
          RowBox[{"k", " ", "Ra"}], "]"}], "+", 
         RowBox[{"td", " ", 
          RowBox[{"Cos", "[", 
           RowBox[{"k", " ", "Ra"}], "]"}]}]}], ")"}]}]}], ",", 
     RowBox[{"Fb", "==", 
      RowBox[{"A", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"Sin", "[", 
          RowBox[{"k", " ", "Rb"}], "]"}], "+", 
         RowBox[{"td", " ", 
          RowBox[{"Cos", "[", 
           RowBox[{"k", " ", "Rb"}], "]"}]}]}], ")"}]}]}]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"A", ",", "td"}], "}"}]}], "]"}]], "Input",
 CellChangeTimes->{{3.92579128009443*^9, 3.9257913573449*^9}},
