  3.925182388773055*^9}},ExpressionUUID->"fa50fc59-c855-4eb5-b8c2-\
034efd65f671"],

Cell[TextData[{
 "So the solution to the noninteracting problem are Mathieu functions, which \
are periodic with period ",
 Cell[BoxData[
  FormBox[
   RowBox[{"2", "\[Pi]", " ", "n"}], TraditionalForm]],ExpressionUUID->
  "84d75e3a-2a39-46dc-be76-fcc1bf3dd74d"],
 " when ",
 Cell[BoxData[
  FormBox[
   RowBox[{"a", "(", "q", ")"}], TraditionalForm]],ExpressionUUID->
  "40b00dda-8ec1-4d1a-94d4-81f4779bc9f2"],
 " is given by its characteristic value (use A for the even function and B \
for the odd function):"
}], "Text",
 CellChangeTimes->{{3.925134362455065*^9, 3.925134427320128*^9}, {
  3.925181949316654*^9, 
  3.92518196481596*^9}},ExpressionUUID->"da624e49-df1e-418d-8f3b-\
11ccb55bb7f5"],

