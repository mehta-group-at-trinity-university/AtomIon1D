Cell[BoxData[
 RowBox[{
  RowBox[{"phiHO", "[", 
   RowBox[{"n_", ",", "x_"}], "]"}], ":=", 
  RowBox[{
   FractionBox[
    RowBox[{"HermiteH", "[", 
     RowBox[{"n", ",", "x"}], "]"}], 
    RowBox[{
     SuperscriptBox["\[Pi]", 
      RowBox[{"(", 
       RowBox[{"1", "/", "4"}], ")"}]], 
     SqrtBox[
      RowBox[{
       SuperscriptBox["2", "n"], 
       RowBox[{"n", "!"}]}]]}]], 
   SuperscriptBox["\[ExponentialE]", 
    FractionBox[
     RowBox[{"-", 
      SuperscriptBox["x", "2"]}], "2"]]}]}]], "Input",
 CellChangeTimes->{{3.995704147408896*^9, 3.995704152351098*^9}},
 CellLabel->
  "In[230]:=",ExpressionUUID->"17711b74-2442-44c4-904a-2c314365dcfe"],

Cell[BoxData[
 RowBox[{
  RowBox[{"F", "[", 
   RowBox[{"n_", ",", "k_", ",", "R_"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"a", ",", "q", ",", "z", ",", "U", ",", "\[Theta]"}], "}"}], ",",
     "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{
      RowBox[{"{", 
       RowBox[{"U", ",", "q", ",", "a"}], "}"}], "=", 
      RowBox[{"NIOddEnergy", "[", 
       RowBox[{"n", ",", "mu", ",", "R"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"NIntegrate", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"Conjugate", "[", 
         RowBox[{"MathieuS", "[", 
          RowBox[{"a", ",", "q", ",", "\[Theta]"}], "]"}], "]"}], 
        RowBox[{"phiHO", "[", 
         RowBox[{
          RowBox[{"n", "-", "1"}], ",", 
          RowBox[{"R", " ", 
           RowBox[{"Cos", "[", "\[Theta]", "]"}]}]}], "]"}], 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"Cos", "[", " ", 
           RowBox[{"k", " ", "R", " ", 
            RowBox[{"Sin", "[", "\[Theta]", "]"}]}], "]"}], ",", 
          RowBox[{"Sin", "[", 
           RowBox[{"k", " ", "R", " ", 
            RowBox[{"Sin", "[", "\[Theta]", "]"}]}], "]"}]}], "}"}]}], ",", 
       RowBox[{"{", 
        RowBox[{"\[Theta]", ",", "thetaC", ",", 
         RowBox[{"thetaC", "+", "\[Pi]"}]}], "}"}], ",", 
       RowBox[{"Method", "->", "\"\<GlobalAdaptive\>\""}]}], "]"}]}]}], " ", 
   "\[IndentingNewLine]", "]"}]}]], "Input",
 CellChangeTimes->{{3.995703859824667*^9, 3.9957039960095*^9}, {
