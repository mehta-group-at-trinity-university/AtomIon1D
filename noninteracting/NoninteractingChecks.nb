  "In[155]:=",ExpressionUUID->"93d1de15-66eb-472b-9a25-6975b9c9c137"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"{", 
   RowBox[{
    RowBox[{"A", "\[Rule]", 
     FractionBox[
      RowBox[{
       RowBox[{"Fb", " ", 
        RowBox[{"Cos", "[", 
         RowBox[{"k", " ", "Ra"}], "]"}]}], "-", 
       RowBox[{"Fa", " ", 
        RowBox[{"Cos", "[", 
         RowBox[{"k", " ", "Rb"}], "]"}]}]}], 
      RowBox[{
       RowBox[{
        RowBox[{"-", 
         RowBox[{"Cos", "[", 
          RowBox[{"k", " ", "Rb"}], "]"}]}], " ", 
        RowBox[{"Sin", "[", 
         RowBox[{"k", " ", "Ra"}], "]"}]}], "+", 
       RowBox[{
        RowBox[{"Cos", "[", 
         RowBox[{"k", " ", "Ra"}], "]"}], " ", 
        RowBox[{"Sin", "[", 
         RowBox[{"k", " ", "Rb"}], "]"}]}]}]]}], ",", 
    RowBox[{"td", "\[Rule]", 
     FractionBox[
      RowBox[{
       RowBox[{
        RowBox[{"-", "Fb"}], " ", 
        RowBox[{"Sin", "[", 
         RowBox[{"k", " ", "Ra"}], "]"}]}], "+", 
       RowBox[{"Fa", " ", 
        RowBox[{"Sin", "[", 
         RowBox[{"k", " ", "Rb"}], "]"}]}]}], 
      RowBox[{
       RowBox[{"Fb", " ", 
        RowBox[{"Cos", "[", 
         RowBox[{"k", " ", "Ra"}], "]"}]}], "-", 
       RowBox[{"Fa", " ", 
        RowBox[{"Cos", "[", 
         RowBox[{"k", " ", "Rb"}], "]"}]}]}]]}]}], "}"}], "}"}]], "Output",
