Cell[BoxData[
 RowBox[{
  RowBox[{"NIEvenEnergy", "[", 
   RowBox[{"n_", ",", "mass_", ",", "R_"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"q", ",", "a", ",", "U", ",", "f"}], "}"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"q", "=", 
      RowBox[{
       FractionBox["1", "4"], 
       SuperscriptBox["mass", "2"], " ", 
       SuperscriptBox["R", "4"]}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"a", "=", 
      RowBox[{"MathieuCharacteristicA", "[", 
       RowBox[{"n", ",", "q"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"U", "=", 
      FractionBox[
       RowBox[{"a", "+", 
        RowBox[{"2", "q"}]}], 
       RowBox[{"4", 
        SqrtBox["q"]}]]}], ";", "\[IndentingNewLine]", 
     RowBox[{"{", 
      RowBox[{"U", ",", "q", ",", "a"}], "}"}]}]}], "\[IndentingNewLine]", 
   "]"}]}]], "Input",
 CellChangeTimes->{{3.92518212464741*^9, 3.9251822327938843`*^9}, {
