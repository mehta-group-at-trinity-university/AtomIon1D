  3.925182322525907*^9}},ExpressionUUID->"765fa236-1fe8-43aa-b8a7-\
7c775e50bd95"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    RowBox[{"4", 
     SqrtBox["q"], "U"}], "-", 
    RowBox[{"2", "q"}]}], "=", 
   RowBox[{"a", "(", "q", ")"}]}], TraditionalForm]], "EquationNumbered",
 CellChangeTimes->{{3.9251338384087*^9, 3.925133872776412*^9}, 
   3.9251823680203533`*^9},ExpressionUUID->"77426266-5a41-43e2-b85b-\
27abe3dc486b"],

Cell[BoxData[
 FormBox[
  RowBox[{"U", "=", 
   FractionBox[
    RowBox[{
     RowBox[{"a", "(", "q", ")"}], "+", 
     RowBox[{"2", "q"}]}], 
    RowBox[{"4", 
     SqrtBox["q"]}]]}], TraditionalForm]], "EquationNumbered",
 CellChangeTimes->{{3.925133877939152*^9, 3.925133916561982*^9}, {
