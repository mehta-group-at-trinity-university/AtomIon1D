Cell[BoxData[
 RowBox[{
  RowBox[{"SingleChannelPhase", "[", 
   RowBox[{
   "EE_", ",", "mu_", ",", "V_", ",", "R1_", ",", "R2_", ",", "Eth_"}], "]"}],
   ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "td", ",", " ", "k", ",", "Fsol", ",", "F", ",", "R", ",", "Fa", ",", 
      "Fb", ",", "Ra", ",", "Rb", ",", "ascat", ",", "delta"}], "}"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"k", "=", 
      SqrtBox[
       RowBox[{"2", " ", "mu", 
        RowBox[{"(", 
         RowBox[{"EE", "-", "Eth"}], ")"}]}]]}], ";", "\[IndentingNewLine]", 
     RowBox[{"Fsol", "=", 
      RowBox[{"NDSolve", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{
             FractionBox[
              RowBox[{"-", "1"}], 
              RowBox[{"2", "mu"}]], 
             RowBox[{
              RowBox[{"F", "''"}], "[", "R", "]"}]}], "+", 
            RowBox[{
             RowBox[{"(", 
              RowBox[{
               RowBox[{"Veff0", "[", "R", "]"}], "-", "EE"}], ")"}], 
             RowBox[{"F", "[", "R", "]"}]}]}], "==", "0"}], ",", 
          RowBox[{
           RowBox[{"F", "[", "R1", "]"}], "==", "0"}], ",", 
          RowBox[{
           RowBox[{
            RowBox[{"F", "'"}], "[", "R1", "]"}], "==", "0.01"}]}], "}"}], 
        ",", 
        RowBox[{"F", "[", "R", "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"R", ",", "R1", ",", "R2"}], "}"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"Ra", "=", 
      RowBox[{"0.9", " ", "R2"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"Rb", "=", 
      RowBox[{"0.99", "R2"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"Fa", "=", 
      RowBox[{
       RowBox[{
        RowBox[{"F", "[", "R", "]"}], "/.", 
        RowBox[{"Fsol", "[", 
         RowBox[{"[", "1", "]"}], "]"}]}], "/.", 
       RowBox[{"R", "->", "Ra"}]}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"Fb", "=", 
      RowBox[{
       RowBox[{
        RowBox[{"F", "[", "R", "]"}], "/.", 
        RowBox[{"Fsol", "[", 
         RowBox[{"[", "1", "]"}], "]"}]}], "/.", 
       RowBox[{"R", "->", "Rb"}]}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"td", "=", 
      FractionBox[
       RowBox[{
        RowBox[{
         RowBox[{"-", "Fb"}], " ", 
         RowBox[{"Sin", "[", 
          RowBox[{"k", " ", "Ra"}], "]"}]}], "+", 
        RowBox[{"Fa", " ", 
         RowBox[{"Sin", "[", 
          RowBox[{"k", " ", "Rb"}], "]"}]}]}], 
       RowBox[{
        RowBox[{"Fb", " ", 
         RowBox[{"Cos", "[", 
          RowBox[{"k", " ", "Ra"}], "]"}]}], "-", 
        RowBox[{"Fa", " ", 
         RowBox[{"Cos", "[", 
          RowBox[{"k", " ", "Rb"}], "]"}]}]}]]}], ";", "\[IndentingNewLine]", 
     
     RowBox[{"ascat", "=", 
      RowBox[{
       RowBox[{"-", "td"}], "/", "k"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"delta", "=", 
      RowBox[{"ArcTan", "[", "td", "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"{", 
      RowBox[{"ascat", ",", "delta"}], "}"}]}]}], "\[IndentingNewLine]", 
   "]"}]}]], "Input",
